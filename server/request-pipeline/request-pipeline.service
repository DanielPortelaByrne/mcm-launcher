[Unit]
Description=MCM request search reconciliation and status
After=network-online.target seerr.service sonarr.service radarr.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/media-stack/request-pipeline/request_pipeline.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/media-stack/request-pipeline
PrivateTmp=true

[Install]
WantedBy=default.target
