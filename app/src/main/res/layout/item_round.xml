<?xml version="1.0" encoding="utf-8"?>
<!-- A round app tile: the full-bleed disc inside its focus mat, name beneath.
     Sizes are applied in ShelfLayoutBuilder so the shelf and the app drawer share it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tileRing"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/tileIcon"
                android:layout_width="@dimen/tile_icon_size"
                android:layout_height="@dimen/tile_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitXY" />
        </FrameLayout>

        <TextView
            android:id="@+id/tileLabel"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</FrameLayout>
